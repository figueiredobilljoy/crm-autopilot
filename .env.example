# Optional AI engine keys. Leave empty to use the built-in deterministic engine.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional WooCommerce read-only credentials. Leave empty to use bundled sample data.
WC_STORE_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Server port
PORT=3001
